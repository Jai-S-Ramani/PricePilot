# PricePilot Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.

# -------------------------------------------------------------
# 1. Google Identity Services (GIS) OAuth 2.0 Client ID
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# Format: 123456789012-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# -------------------------------------------------------------
GOOGLE_CLIENT_ID=

# -------------------------------------------------------------
# 2. Flask Application Secret Key
# Used for encrypting session cookies.
# -------------------------------------------------------------
FLASK_SECRET_KEY=pricepilot_production_secure_secret_key_2026

# -------------------------------------------------------------
# 3. Server Binding Config (Optional)
# -------------------------------------------------------------
PORT=5000
HOST=0.0.0.0

